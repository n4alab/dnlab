# Canonical dNLab site inventory. This is YAML (hosts.yml), not XML.
# Copy to /etc/dnlab/hosts.yml, or set DNLAB_MULTINODE_HOSTS to another YAML file.
# All values below are the supported schema; remove optional blocks to use defaults.

infrastructure:
  master:
    host: 10.0.0.1
    ssh_user: root
    ssh_key: ~/.ssh/id_ed25519
  workers:
    worker1:
      host: 10.0.0.2
      ssh_user: root
      ssh_key: ~/.ssh/id_ed25519

  # One site-wide interface used to discover every host's VXLAN underlay IP.
  # Per-host `interface:` keys are invalid and are not supported.
  underlay_iface: eth0

  jumphost_net:
    network: dnlab-jumphost
    bridge: br-dnlab-jh
    ipv4_subnet: 192.168.100.0/24
    ipv4_gw: 192.168.100.1
    ssh_port_range: "2200-2299"
    ssh_bind_ip: 0.0.0.0

  webui_ports:
    port_range: "8443-8999"
    bind_ip: 127.0.0.1

  realnet:
    network: dnlab-realnet
    bridge: br-dnlab-rn
    ipv4_subnet: 192.168.101.0/24
    ipv4_gw: 192.168.101.1
    image: ghcr.io/n4alab/dnlab-realnet-router:latest
    wan_iface: ""
    rr_as: 64512
    rr_ip: ""
    host_net: ""
    router_as_pool: "64513-65534"
    router_ip_pool: ""
    realnet_network_pool: 100.64.0.0/10
    rr_password: ""

  persistence:
    backend: local-sticky
    root: /var/lib/docker/dnlab-backups
    allow_migration_fallback: true
    cephfs:
      mountpoint: /var/lib/docker/dnlab-backups
      expected_fstype: ceph
      marker: .dnlab-cephfs
      require_shared_marker: true

defaults:
  mgmt:
    ipv4_subnet: 172.20.0.0/24
    ipv4_gw: 172.20.0.1

image_sync:
  enabled: true
  include:
    - "*"
  exclude:
    - dnlab-jumphost
    - dnlab-dns
    - dnlab-realnet-router
    - dnlab-realnet-rr
    - postgres
    - "<none>:<none>"
  interval_seconds: 300

lab_cleanup:
  enabled: true
  interval_seconds: 300
  grace_seconds: 600
  dry_run: false

follow_the_rabbit:
  max_sessions: 1
